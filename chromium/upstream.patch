+void AppearanceHandler::HandleAgenticUILanguage(const base::ListValue& args) {
+  CHECK(args.size() == 1 || args.size() == 2);
+  AllowJavascript();
+  auto* prefs = g_browser_process->local_state();
+  if (args.size() == 2) {
+    const auto& locale = args[1].GetString();
+    if ((locale != "" && locale != "en-US" && locale != "zh-CN") ||
+        prefs->IsManagedPreference(language::prefs::kApplicationLocale)) {
+      RejectJavascriptCallback(args[0], base::Value("language_not_available"));
+      return;
+    }
+    prefs->SetString(language::prefs::kApplicationLocale, locale);
+    prefs->CommitPendingWrite();
+  }
+  const auto locale = prefs->GetString(language::prefs::kApplicationLocale);
+#if BUILDFLAG(IS_MAC)
+  const auto system_locale = l10n_util::GetLocaleOverride();
+#else
+  const auto system_locale = l10n_util::GetApplicationLocale("");
+#endif
+  base::DictValue result;
+  result.Set("locale", locale);
+  result.Set("pending", (locale.empty() ? system_locale : locale) !=
+                            g_browser_process->GetApplicationLocale());
+  result.Set("managed", prefs->IsManagedPreference(language::prefs::kApplicationLocale));
+  ResolveJavascriptCallback(args[0], result);
+}
